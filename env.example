# MovieDB local configuration
PORT=8081
MOVIEDB_DATABASE_URL=jdbc:sqlite:movies.db
MOVIEDB_DDL_AUTO=create
MOVIEDB_SQL_INIT=always
MOVIEDB_SHOW_SQL=false
MOVIEDB_ALLOWED_ORIGINS=*

# Demo-friendly public keys documented for local testing only.
# Do not use these as production secrets.
MOVIEDB_PUBLIC_API_KEYS=moviedb-demo-key,moviedb-readonly-key

# Optional external movie providers. OMDb supports a limited demo key called demo.
OMDB_API_KEY=demo
TMDB_API_KEY=
